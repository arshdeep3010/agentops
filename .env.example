# Local Postgres from docker-compose (dev-only credentials)
DATABASE_URL=postgresql://agentops:agentops@localhost:54329/agentops

# "fake" runs offline with deterministic model replies; "live" calls the model API.
LLM_MODE=fake
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Engine
# How long a step stays claimed without a heartbeat. 30 is a sensible production value;
# 6 makes the "kill a worker" demo take over within a few seconds.
LEASE_SECONDS=6
# Dev convenience: the API starts this many worker processes and can kill/restart them (demo).
SPAWN_WORKERS=3
